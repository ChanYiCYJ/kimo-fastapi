# ---- 应用 ----
APP_NAME=FastAPI 标准项目示例
APP_VERSION=1.0.0
DEBUG=true

# ---- 数据库（sqlite 或 mysql）----
# 使用 sqlite：无需安装/配置数据库，直接生成 db.sqlite3 文件
# DB_ENGINE=sqlite

# 使用 mysql 时配置以下参数：
DB_ENGINE=mysql
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-password
DB_NAME=your-db-name

# ---- JWT 认证 ----
# 生产环境务必替换为足够长的随机字符串（≥32字节）
JWT_SECRET_KEY=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- 上传 ----
# UPLOAD_DIR=static/uploads
# MAX_UPLOAD_SIZE=5242880
